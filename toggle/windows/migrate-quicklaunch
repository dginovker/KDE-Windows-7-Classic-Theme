#!/usr/bin/env python3
"""Fold legacy Quick Launch widgets into an existing Classic taskbar, preserving all unrelated bytes.

Called only with plasmashell stopped, on the Windows layout being activated. No panel is rebuilt.
"""
import argparse
from pathlib import Path
import sys

from launchers import normalize_launchers
from layout import Layout, replace_layout


def migrate(text):
    layout = Layout(text)
    edits, plans = [], []
    for panel in layout.groups:
        if len(panel) != 2 or panel[0] != 'Containments' or layout.get(panel, 'plugin') != 'org.kde.panel':
            continue
        children = [g for g in layout.groups if len(g) == 4 and g[:3] == (*panel, 'Applets')]
        quick = [g for g in children if layout.get(g, 'plugin') == 'org.kde.plasma.quicklaunch']
        classic = [g for g in children if layout.get(g, 'plugin') == 'org.win7classic.taskbar']
        if not quick or not classic:
            continue
        order_group = (*panel, 'General')
        order = (layout.get(order_group, 'AppletOrder') or '').split(';')
        if len(classic) != 1 or order.count(classic[0][-1]) != 1:
            raise ValueError(f'panel {panel[1]} has no unambiguous ordered Classic destination')
        pins_group = (*classic[0], 'Configuration', 'General')
        pins = layout.get(pins_group, 'launchers')
        if pins is None:
            raise ValueError(f'panel {panel[1]} Classic taskbar has no explicit saved launcher list')
        quick.sort(key=lambda g: order.index(g[-1]) if g[-1] in order else len(order))
        values = [pins]
        for group in quick:
            general = (*group, 'Configuration', 'General')
            values.extend(layout.get(general, key) or '' for key in ('launcherUrls', 'popupUrls'))
        merged = normalize_launchers(values)
        remaining = ';'.join(item for item in order if item not in {g[-1] for g in quick})
        edits.append((*layout.value_span(pins_group, 'launchers'), merged))
        edits.append((*layout.value_span(order_group, 'AppletOrder'), remaining))
        for group, (start, end) in layout.groups.items():
            if any(group[:4] == q for q in quick):
                edits.append((start, end, ''))
        plans.append((panel[1], pins_group, merged, order_group, remaining, quick))

    result = text
    for start, end, replacement in sorted(edits, reverse=True):
        result = result[:start] + replacement + result[end:]
    verified = Layout(result)
    for panel, pins_group, merged, order_group, remaining, quick in plans:
        if verified.get(pins_group, 'launchers') != merged or verified.get(order_group, 'AppletOrder') != remaining or any(
                group[:4] in quick for group in verified.groups):
            raise ValueError(f'panel {panel} migration validation failed')
    return result, [panel for panel, *_ in plans]


def main(path, check=False):
    path = Path(path)
    original = path.read_bytes()
    result, panels = migrate(original.decode('utf-8'))
    if not panels:
        return
    message = 'folded Quick Launch into Classic taskbar on panel(s): ' + ', '.join(panels)
    if check:
        print(message)
        return
    replace_layout(path, original, result)
    print(message)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='validate and report the plan without writing')
    parser.add_argument('path')
    args = parser.parse_args()
    try:
        main(args.path, check=args.check)
    except (OSError, ValueError) as error:
        sys.exit(f'Quick Launch migration failed: {error}')
