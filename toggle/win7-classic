#!/usr/bin/env bash
# Switch Plasma between the user's current layout and the Windows 7 Classic layout.
# Only plasmashell restarts; KWin and every application keep running.
set -euo pipefail

FILES=(plasma-org.kde.plasma.desktop-appletsrc plasmashellrc)
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=${XDG_STATE_HOME:-$HOME/.local/state}/win7-classic
share=$(dirname "$(readlink -f "$0")")
[[ -f $share/windows-layout.js ]] || share=${XDG_DATA_HOME:-$HOME/.local/share}/win7-classic
mkdir -p "$state/profiles"

log() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$state/switch.log" >&2; }
die() { log "ERROR: $*"; exit 1; }
mode() { cat "$state/mode" 2>/dev/null || echo current; }
shell() { qdbus6 org.kde.plasmashell /PlasmaShell evaluateScript "$1"; }
digest() { (cd "$1" && sha256sum "${FILES[@]}" 2>/dev/null | tr '\n' ' '); }

stop_shell() {
    systemctl --user stop plasma-plasmashell.service
    ! pgrep -u "$UID" -x plasmashell >/dev/null || die "plasmashell still running after stop"
}

start_shell() {
    # Rapid toggles otherwise trip systemd's start rate limit and plasmashell silently stays down.
    systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
    systemctl --user start plasma-plasmashell.service || return 1
    for _ in $(seq 60); do
        shell 'print(panels().length)' >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 1
}

# A widget whose plugin is not installed loads as an empty placeholder, so check every panel widget.
unknown_widgets() {
    shell 'var bad = []; for (const p of panels()) for (const w of p.widgets()) if (knownWidgetTypes.indexOf(w.type) < 0) bad.push(w.type); print(bad.join(" "))'
}

copy_files() { for f in "${FILES[@]}"; do [[ ! -e $1/$f ]] || cp -p "$1/$f" "$2/$f"; done; }

switch_to() {
    local target=$1 from
    from=$(mode)
    [[ $target != "$from" ]] || { log "already in $target mode"; return 0; }
    log "switching $from -> $target"
    stop_shell
    rm -rf "$state/profiles/$from.new" && mkdir "$state/profiles/$from.new"
    copy_files "$config" "$state/profiles/$from.new"
    rm -rf "$state/profiles/$from" && mv "$state/profiles/$from.new" "$state/profiles/$from"
    log "saved $from: $(digest "$state/profiles/$from")"

    local seed=0
    if [[ -d $state/profiles/$target ]]; then
        copy_files "$state/profiles/$target" "$config"
    else
        seed=1
    fi
    local problem=""
    if ! start_shell; then
        problem="plasmashell did not start"
    else
        [[ $seed == 0 ]] || shell "$(cat "$share/$target-layout.js")" >/dev/null || problem="layout script failed"
        [[ -n $problem ]] || { local bad; bad=$(unknown_widgets); [[ -z $bad ]] || problem="unknown widgets: $bad"; }
    fi
    if [[ -n $problem ]]; then
        log "rolling back to $from: $problem"
        stop_shell
        copy_files "$state/profiles/$from" "$config"
        start_shell || die "rollback could not start plasmashell; run: win7-classic restore"
        die "switch to $target failed ($problem); still in $from mode"
    fi
    echo "$target" > "$state/mode"
    log "now in $target mode: $(digest "$config")"
}

restore() {
    [[ -d $state/profiles/current ]] || { [[ $(mode) == current ]] && { log "already current; nothing saved"; return 0; }; die "no saved current profile"; }
    log "restore: forcing current mode"
    systemctl --user stop plasma-plasmashell.service || true
    pkill -u "$UID" -x plasmashell || true
    # Keep whatever was live, in case it held edits worth recovering.
    rm -rf "$state/profiles/before-restore" && mkdir "$state/profiles/before-restore"
    copy_files "$config" "$state/profiles/before-restore"
    copy_files "$state/profiles/current" "$config"
    echo current > "$state/mode"
    start_shell || die "plasmashell did not start after restore"
    log "restored current: $(digest "$config")"
}

case ${1:-} in
    windows|current) switch_to "$1" ;;
    toggle) [[ $(mode) == current ]] && switch_to windows || switch_to current ;;
    restore) restore ;;
    status) mode ;;
    *) echo "usage: win7-classic windows|current|toggle|status|restore" >&2; exit 2 ;;
esac
