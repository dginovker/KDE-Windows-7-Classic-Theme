#!/usr/bin/env bash
# Switch Plasma between the user's current layout and the Windows 7 Classic layout.
# Only plasmashell restarts; KWin and every application keep running.
set -euo pipefail

FILES=(plasma-org.kde.plasma.desktop-appletsrc plasmashellrc plasmarc)
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=${XDG_STATE_HOME:-$HOME/.local/state}/win7-classic
share=$(dirname "$(readlink -f "$0")")
[[ -d $share/windows ]] || { echo "win7-classic: $share/windows is missing; reinstall" >&2; exit 1; }
mkdir -p "$state/profiles"

log() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$state/switch.log" >&2; }
die() { log "ERROR: $*"; exit 1; }
mode() { cat "$state/mode" 2>/dev/null || echo current; }
shell() { qdbus6 org.kde.plasmashell /PlasmaShell evaluateScript "$1"; }
digest() { (cd "$1" && sha256sum "${FILES[@]}" 2>/dev/null | tr '\n' ' '); }

stop_shell() {
    systemctl --user stop plasma-plasmashell.service
    ! pgrep -u "$UID" -x plasmashell >/dev/null || die "plasmashell still running after stop"
}

start_shell() {
    # Rapid toggles otherwise trip systemd's start rate limit and plasmashell silently stays down.
    systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
    systemctl --user start plasma-plasmashell.service || return 1
    for _ in $(seq 60); do
        shell 'print(panels().length)' >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 1
}

# A widget whose plugin is not installed loads as an empty placeholder, so check every panel widget.
unknown_widgets() {
    shell 'var bad = []; for (const p of panels()) for (const w of p.widgets()) if (knownWidgetTypes.indexOf(w.type) < 0) bad.push(w.type); print(bad.join(" "))'
}

# Mirror, not merge: a file the source mode never had (e.g. no plasmarc) must not leak in from the other mode.
# kdeglobals/kwinrc also hold non-appearance settings, so only the keys named in windows/keys are swapped per mode.
save_keys() { "$share/kconfig-keys" save "$share/windows/keys" "$config" "$1/keys.json"; }
load_keys() {
    local file changed
    while IFS=$'\t' read -r file changed; do
        gdbus emit --session --object-path "/$file" --signal org.kde.kconfig.notify.ConfigChanged "$changed" >/dev/null
    done < <("$share/kconfig-keys" load "$1" "$config")
    # Running Qt apps (KWin included) re-read palette (0), fonts (1) and widget style (2) from kdeglobals on these
    # signals; fonts also need refreshFonts. KWin's reconfigure must come after so its title bar picks up the new font.
    for change in 0 1 2; do
        dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:$change int32:0
    done
    dbus-send --session --type=signal /KDEPlatformTheme org.kde.KDEPlatformTheme.refreshFonts
    qdbus6 org.kde.KWin /KWin reconfigure
}

# Running GTK apps follow the gtk-theme GSetting live. Only that dconf key is swapped: KDE's own setGtkTheme
# would also regenerate the user's ~/.config/gtk-*/ files, which then don't come back byte-for-byte.
# An empty saved value means the key was unset (GTK's default), so it is reset rather than written.
GTK_KEY=/org/gnome/desktop/interface/gtk-theme
gtk_theme() { dconf read "$GTK_KEY"; }
set_gtk_theme() { if [[ -n $1 ]]; then dconf write "$GTK_KEY" "$1"; else dconf reset "$GTK_KEY"; fi; }

# Apply a saved mode's appearance keys and GTK theme. Profiles saved by versions before 0.2 have neither file:
# those versions never changed these settings in current mode, and Windows mode falls back to what it ships.
load_appearance() {
    local mode=$1 dir=$2
    echo "$mode" > "$state/appearance"
    if [[ -f $dir/keys.json ]]; then load_keys "$dir/keys.json"
    elif [[ -d $share/$mode/keys ]]; then load_keys "$share/$mode/keys"; fi
    if [[ -f $dir/gtk-theme ]]; then set_gtk_theme "$(cat "$dir/gtk-theme")"
    elif [[ -f $share/$mode/gtk-theme ]]; then set_gtk_theme "$(cat "$share/$mode/gtk-theme")"; fi
}

copy_files() { for f in "${FILES[@]}"; do if [[ -e $1/$f ]]; then cp -p "$1/$f" "$2/$f"; else rm -f "$2/$f"; fi; done; }

switch_to() {
    local target=$1 from
    from=$(mode)
    [[ $target != "$from" ]] || { log "already in $target mode"; return 0; }
    log "switching $from -> $target"
    stop_shell
    rm -rf "$state/profiles/$from.new" && mkdir "$state/profiles/$from.new"
    copy_files "$config" "$state/profiles/$from.new"
    # Only save appearance that belongs to the mode we're leaving. Versions before 0.2 never applied any, so after
    # upgrading in Windows mode the live colors are still current mode's and must not become Windows mode's.
    if [[ $(cat "$state/appearance" 2>/dev/null || echo current) == "$from" ]]; then
        save_keys "$state/profiles/$from.new"
        gtk_theme > "$state/profiles/$from.new/gtk-theme"
    fi
    rm -rf "$state/profiles/$from" && mv "$state/profiles/$from.new" "$state/profiles/$from"
    log "saved $from: $(digest "$state/profiles/$from") $(cd "$state/profiles/$from" && sha256sum keys.json 2>/dev/null)"

    local seed=0
    if [[ -d $state/profiles/$target ]]; then
        copy_files "$state/profiles/$target" "$config"
        load_appearance $target "$state/profiles/$target"
    else
        # First use of a mode: start from its shipped config files (e.g. the panel theme), then run its layout script.
        seed=1
        for f in "${FILES[@]}"; do [[ ! -e $share/$target/$f ]] || cp "$share/$target/$f" "$config/$f"; done
        load_appearance "$target" "$share/$target"
    fi
    local problem=""
    if ! start_shell; then
        problem="plasmashell did not start"
    else
        [[ $seed == 0 ]] || shell "$(cat "$share/$target/layout.js")" >/dev/null || problem="layout script failed"
        [[ -n $problem ]] || { local bad; bad=$(unknown_widgets); [[ -z $bad ]] || problem="unknown widgets: $bad"; }
    fi
    if [[ -n $problem ]]; then
        log "rolling back to $from: $problem"
        stop_shell
        copy_files "$state/profiles/$from" "$config"
        load_appearance $from "$state/profiles/$from"
        start_shell || die "rollback could not start plasmashell; run: win7-classic restore"
        die "switch to $target failed ($problem); still in $from mode"
    fi
    echo "$target" > "$state/mode"
    log "now in $target mode: $(digest "$config")"
}

restore() {
    [[ -d $state/profiles/current ]] || { [[ $(mode) == current ]] && { log "already current; nothing saved"; return 0; }; die "no saved current profile"; }
    log "restore: forcing current mode"
    systemctl --user stop plasma-plasmashell.service || true
    pkill -u "$UID" -x plasmashell || true
    # Keep whatever was live, in case it held edits worth recovering.
    rm -rf "$state/profiles/before-restore" && mkdir "$state/profiles/before-restore"
    copy_files "$config" "$state/profiles/before-restore"
    save_keys "$state/profiles/before-restore"
    gtk_theme > "$state/profiles/before-restore/gtk-theme"
    copy_files "$state/profiles/current" "$config"
    load_appearance current "$state/profiles/current"
    echo current > "$state/mode"
    start_shell || die "plasmashell did not start after restore"
    log "restored current: $(digest "$config")"
}

case ${1:-} in
    windows|current) switch_to "$1" ;;
    toggle) [[ $(mode) == current ]] && switch_to windows || switch_to current ;;
    restore) restore ;;
    status) mode ;;
    *) echo "usage: win7-classic windows|current|toggle|status|restore" >&2; exit 2 ;;
esac
