#!/usr/bin/env bash
# Switch Plasma between the user's current layout and the Windows 7 Classic layout.
# Only plasmashell restarts; KWin and every application keep running.
set -euo pipefail

FILES=(plasma-org.kde.plasma.desktop-appletsrc plasmashellrc plasmarc)
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=${XDG_STATE_HOME:-$HOME/.local/state}/win7-classic
share=$(dirname "$(readlink -f "$0")")
[[ -d $share/windows ]] || { echo "win7-classic: $share/windows is missing; reinstall" >&2; exit 1; }
probe=$(dirname "$(dirname "$share")")/bin/win7-classic-probe
mkdir -p "$state/profiles"
accelerators=$state/current-tray-accelerators.json

log() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$state/switch.log" >&2; }
die() { log "ERROR: $*"; exit 1; }
mode() { cat "$state/mode" 2>/dev/null || echo current; }
shell() { qdbus6 org.kde.plasmashell /PlasmaShell evaluateScript "$1"; }
digest() { (cd "$1" && sha256sum "${FILES[@]}" 2>/dev/null | tr '\n' ' '); }

stop_shell() {
    systemctl --user stop plasma-plasmashell.service
    ! pgrep -u "$UID" -x plasmashell >/dev/null || die "plasmashell still running after stop"
}

start_shell() {
    # Rapid toggles otherwise trip systemd's start rate limit and plasmashell silently stays down.
    systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
    systemctl --user start plasma-plasmashell.service || return 1
    for _ in $(seq 60); do
        shell 'print(panels().length)' >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 1
}

# A widget whose plugin is not installed loads as an empty placeholder, so check every panel widget.
unknown_widgets() {
    shell 'var bad = []; for (const p of panels()) for (const w of p.widgets()) if (knownWidgetTypes.indexOf(w.type) < 0) bad.push(w.type); print(bad.join(" "))'
}

# Mirror, not merge: a file the source mode never had (e.g. no plasmarc) must not leak in from the other mode.
# kdeglobals/kwinrc also hold non-appearance settings, so only the keys named in windows/keys are swapped per mode.
save_keys() { "$share/kconfig-keys" save "$share/windows/keys" "$config" "$1/keys.json" ${2:+"$2"}; }
load_keys() {
    local file changed required=""
    [[ $(cat "$state/appearance") != windows ]] || required=$share/windows/required-keys
    while IFS=$'\t' read -r file changed; do
        # D-Bus object paths allow only [A-Za-z0-9_]; KConfigWatcher maps the rest of a config name to _ too.
        gdbus emit --session --object-path "/${file//[^A-Za-z0-9]/_}" --signal org.kde.kconfig.notify.ConfigChanged "$changed" >/dev/null
    done < <("$share/kconfig-keys" load "$1" "$config" "${2:-}" "$required")
    # KDE apps resolve the folder handler (mimeapps.list) from the sycoca cache, which doesn't notice the change.
    # Built in the session's environment (XDG_CURRENT_DESKTOP=KDE selects kde-mimeapps.list), even from a TTY.
    systemd-run --user --wait --collect -q kbuildsycoca6 || die "kbuildsycoca6 failed (journalctl --user); folders may open in the wrong app"

    # Update the platform hint before rebuilding Qt's icon cache, and before palette/style events make
    # Dolphin cache folder pixmaps. Repainting first leaves those pixmaps one theme behind.
    dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:4 int32:0
    # Like KDE's icon KCM, invalidate every group: Dolphin's item pixmaps aren't in the Desktop group.
    for group in 0 1 2 3 4 5; do
        dbus-send --session --type=signal /KIconLoader org.kde.KIconLoader.iconChanged int32:$group
    done

    # Running Qt apps (KWin included) re-read palette (0), fonts (1) and widget style (2) from kdeglobals on these
    # signals; fonts also need refreshFonts. KWin's reconfigure must come after so its title bar picks up the new font.
    for change in 0 1 2; do
        dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:$change int32:0
    done
    dbus-send --session --type=signal /KDEPlatformTheme org.kde.KDEPlatformTheme.refreshFonts
    # The cursor KCM uses CursorChanged (5): KWin reloads kcminputrc live, without restarting the compositor.
    # KConfigWatcher above also lets kde-gtk-config update GTK/GSettings and XSettings for running clients.
    dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:5 int32:0
    systemd-run --user --wait --collect -q /usr/lib/plasma-setup-xwayland || die "plasma-setup-xwayland failed (journalctl --user)"
    qdbus6 org.kde.KWin /KWin reconfigure
}

# Running GTK apps follow the gtk-theme GSetting live. Only that dconf key is swapped: KDE's own setGtkTheme
# would also regenerate the user's ~/.config/gtk-*/ files, which then don't come back byte-for-byte.
# An empty saved value means the key was unset (GTK's default), so it is reset rather than written.
GTK_KEY=/org/gnome/desktop/interface/gtk-theme
gtk_theme() { dconf read "$GTK_KEY"; }
set_gtk_theme() { if [[ -n $1 ]]; then dconf write "$GTK_KEY" "$1"; else dconf reset "$GTK_KEY"; fi; }

# Apply a saved mode's appearance keys and GTK theme. Profiles saved by versions before 0.2 have neither file:
# those versions never changed these settings in current mode, and Windows mode falls back to what it ships.
load_appearance() {
    local mode=$1 dir=$2
    echo "$mode" > "$state/appearance"
    if [[ $mode == windows ]]; then add_lock_overlay; else remove_lock_overlay; fi
    if [[ -f $dir/keys.json && $mode == windows ]]; then load_keys "$dir/keys.json" "$share/windows/keys"
    elif [[ -f $dir/keys.json ]]; then load_keys "$dir/keys.json"
    elif [[ -d $share/$mode/keys ]]; then load_keys "$share/$mode/keys"; fi
    if [[ -f $dir/gtk-theme ]]; then set_gtk_theme "$(cat "$dir/gtk-theme")"
    elif [[ -f $share/$mode/gtk-theme ]]; then set_gtk_theme "$(cat "$share/$mode/gtk-theme")"; fi
}

# Windows mode's lock screen: kscreenlocker_greet reads the lock screen from the Plasma shell package, so a per-user
# overlay of that package is created with its own lockscreen/; everything else links to the system shell.
SHELL_ID=org.kde.plasma.desktop
overlay=${XDG_DATA_HOME:-$HOME/.local/share}/plasma/shells/$SHELL_ID
add_lock_overlay() {
    local system=/usr/share/plasma/shells/$SHELL_ID
    remove_lock_overlay
    # A shell package the user made themselves is never replaced; Windows mode then keeps their lock screen.
    [[ ! -e $overlay ]] || { log "WARNING: $overlay is not ours; Windows mode keeps the existing lock screen"; return 0; }
    [[ -d $system ]] || { log "WARNING: no $system; Windows mode keeps the stock lock screen"; return 0; }
    mkdir -p "$overlay/contents"
    touch "$overlay/.win7-classic"
    ln -s "$system/metadata.json" "$overlay/metadata.json"
    local entry
    # Only plasmashell accepts files that resolve outside the package; the lock and logout greeters refuse them, so
    # those two folders are real copies. logout/ is refreshed from the system on every switch to Windows mode.
    for entry in "$system"/contents/*; do
        # updates/ is left out so plasmashell doesn't re-run its migration scripts under the overlay's path.
        case ${entry##*/} in lockscreen|updates) ;; logout) cp -r "$entry" "$overlay/contents/" ;; *) ln -s "$entry" "$overlay/contents/" ;; esac
    done
    cp -r "$share/lockscreen" "$overlay/contents/lockscreen"
}
remove_lock_overlay() {
    [[ -f $overlay/.win7-classic ]] && rm -rf "$overlay"
    return 0
}

copy_files() {
    local f
    for f in "${FILES[@]}"; do
        if [[ -e $1/$f ]]; then cp -p "$1/$f" "$2/$f" || return "$?"
        else rm -f "$2/$f" || return "$?"; fi
    done
}

restore_tray_shortcuts() {
    [[ ! -f $accelerators ]] || "$share/windows/tray-shortcuts" restore "$accelerators"
}

clear_tray_shortcuts() {
    rm -f "$accelerators"
    if [[ -d $accelerators.ids ]]; then rm -r "$accelerators.ids"; fi
}

preflight_windows() {
    [[ -f /usr/lib/qt6/plugins/plasma/applets/org.win7classic.tray.so ]] || die "system-wide Classic notification area is missing; run: cd packaging && makepkg -si"
    [[ -f /usr/lib/qt6/plugins/styles/libwin7classicstyle.so ]] || die "system-wide Win7Classic Qt style is missing; run: cd packaging && makepkg -si"
    systemd-run --user --wait --pipe --collect -q "$probe" --available || die "Win7Classic style cannot load; reinstall: cd packaging && makepkg -si"
}

warn_legacy_other_root() {
    local other=/usr/share
    [[ $share != /usr/share/win7-classic ]] || other=${XDG_DATA_HOME:-$HOME/.local/share}
    if [[ -d $other/kwin/decorations/win7classic || -d $other/win7-classic/primitives ]]; then
        log "WARNING: legacy Classic renderers remain in $other; upgrade that installation too. No other-root files were removed."
    fi
}

migrate_legacy_decoration() {
    local changed
    changed=$("$share/kconfig-keys" migrate-decoration "$config" "$state") || die "legacy decoration migration failed"
    [[ -z $changed ]] || log "$changed"
}

switch_to() {
    local target=$1 from
    from=$(mode)
    warn_legacy_other_root
    [[ $target != windows ]] || preflight_windows
    migrate_legacy_decoration
    [[ $target != "$from" ]] || {
        [[ $target != current ]] || qdbus6 org.kde.KWin /KWin reconfigure
        log "already in $target mode"; return 0;
    }
    local decoration_cursor="" tray_cursor=""
    if [[ $target == windows ]]; then
        decoration_cursor=$(journalctl --user -b -u plasma-kwin_wayland -n0 --show-cursor --no-pager | sed -n 's/^-- cursor: //p')
        [[ -n $decoration_cursor ]] || die "cannot read KWin's journal cursor; decoration activation cannot be verified"
        tray_cursor=$(journalctl --user -b -u plasma-plasmashell -n0 --show-cursor --no-pager | sed -n 's/^-- cursor: //p')
        [[ -n $tray_cursor ]] || die "cannot read plasmashell's journal cursor; tray activation cannot be verified"
    fi
    if [[ $target == windows ]]; then
        [[ ! -e $accelerators ]] || die "pending tray accelerator receipt; run: win7-classic restore"
        local saved_accelerators
        saved_accelerators=$("$share/windows/tray-shortcuts" save "$accelerators") || die "cannot read current tray accelerator registrations"
        (umask 077; mkdir "$accelerators.ids" && printf '%s\n' "$saved_accelerators" > "$accelerators.new" && mv "$accelerators.new" "$accelerators") ||
            { clear_tray_shortcuts; die "cannot preserve current tray accelerator registrations"; }
    fi
    log "switching $from -> $target"
    stop_shell
    rm -rf "$state/profiles/$from.new" && mkdir "$state/profiles/$from.new"
    copy_files "$config" "$state/profiles/$from.new"
    # Only save appearance that belongs to the mode we're leaving. Versions before 0.2 never applied any, so after
    # upgrading in Windows mode the live colors are still current mode's and must not become Windows mode's.
    if [[ $(cat "$state/appearance" 2>/dev/null || echo current) == "$from" ]]; then
        # Windows mode only owns the keys it applied; ones added since its profile was saved still hold current mode's.
        if [[ $from == windows && -f $state/profiles/windows/keys.json ]]; then
            save_keys "$state/profiles/$from.new" "$state/profiles/windows/keys.json"
        else
            save_keys "$state/profiles/$from.new"
        fi
        gtk_theme > "$state/profiles/$from.new/gtk-theme"
    fi
    rm -rf "$state/profiles/$from" && mv "$state/profiles/$from.new" "$state/profiles/$from"
    log "saved $from: $(digest "$state/profiles/$from") $(cd "$state/profiles/$from" && sha256sum keys.json 2>/dev/null)"

    local problem="" failure_status=1 appearance_dir=$state/profiles/$target out
    if [[ $from == windows ]] && ! restore_tray_shortcuts; then
        problem="could not restore current tray accelerators"
    fi
    if [[ -n $problem ]]; then :
    elif [[ -d $appearance_dir ]]; then
        if out=$(copy_files "$appearance_dir" "$config" 2>&1); then :
        else
            failure_status=$?
            problem="copying saved $target layout failed (exit $failure_status)${out:+: $out}"
        fi
        if [[ -z $problem && $target == windows ]]; then
            local migrated backup migration_status
            if migrated=$("$share/windows/migrate-quicklaunch" --check "$config/plasma-org.kde.plasma.desktop-appletsrc" 2>&1); then
                if [[ -n $migrated ]]; then
                    # Recovery must exist before mutation, even if the helper dies just after atomic replacement.
                    if backup=$(mktemp -d "$state/profiles/windows-before-quicklaunch.XXXXXX") &&
                            cp -a "$state/profiles/windows/." "$backup/"; then
                        log "Quick Launch original profile: $backup"
                        if migrated=$("$share/windows/migrate-quicklaunch" "$config/plasma-org.kde.plasma.desktop-appletsrc" 2>&1); then
                            log "$migrated"
                        else
                            migration_status=$?
                            problem="Quick Launch migration failed (exit $migration_status): $migrated"
                        fi
                    else problem="could not preserve the pre-migration Windows profile: $backup"; fi
                fi
            else
                migration_status=$?
                problem="Quick Launch migration check failed (exit $migration_status): $migrated"
            fi
        fi

    else
        # First use of a mode: build it from the layout being left, plus the mode's shipped files (e.g. panel theme).
        for f in "${FILES[@]}"; do [[ ! -e $share/$target/$f ]] || cp "$share/$target/$f" "$config/$f"; done
        if out=$("$share/$target/seed" "$config" 2>&1); then log "seeded $target: $(tr '\n' ' ' <<< "$out")"
        else
            failure_status=$?
            problem="seeding $target failed (exit $failure_status)${out:+: $out}"
        fi
        appearance_dir=$share/$target
    fi
    if [[ -z $problem && $target == windows ]]; then
        local tray_layout original_tray layout_path=$config/plasma-org.kde.plasma.desktop-appletsrc
        if tray_layout=$("$share/windows/migrate-tray" --check "$layout_path" 2>&1); then
            if [[ -n $tray_layout ]]; then
                if original_tray=$(mktemp -d "$state/profiles/windows-before-tray.XXXXXX") &&
                   cp -a "$appearance_dir/." "$original_tray/" &&
                   { [[ $appearance_dir != "$share/windows" ]] || copy_files "$config" "$original_tray"; }; then
                    log "System Tray original staged profile: $original_tray"
                    if tray_layout=$("$share/windows/migrate-tray" "$layout_path" 2>&1); then
                        log "$tray_layout"
                    else
                        failure_status=$?
                        problem="System Tray migration failed (exit $failure_status): $tray_layout"
                    fi
                else problem="could not preserve the pre-migration System Tray profile: $original_tray"; fi
            fi
        else
            failure_status=$?
            problem="System Tray migration check failed (exit $failure_status): $tray_layout"
        fi
    fi
    if [[ -z $problem && $target == windows ]] && ! out=$("$share/windows/check-popup-host" "$layout_path" 2>&1); then
        problem="$out"
    fi
    local tried_target=false
    if [[ -z $problem ]]; then
        tried_target=true
        load_appearance "$target" "$appearance_dir"
    fi
    if [[ -n $problem ]]; then :
    elif ! start_shell; then
        problem="plasmashell did not start"
    else
        if out=$(unknown_widgets); then
            [[ -z $out ]] || problem="unknown widgets: $out"
        else
            failure_status=$?
            problem="querying $target panel widgets failed (exit $failure_status)"
        fi
    fi
    if [[ -z $problem && $target == windows ]]; then
        local trays ready tray_id volume
        if trays=$(shell 'var ids = []; for (const p of panels()) for (const w of p.widgets()) if (w.type === "org.win7classic.tray") ids.push(w.id); print(ids.join(" "))') &&
           ready=$(journalctl --user -b -u plasma-plasmashell --after-cursor "$tray_cursor" --no-pager -o cat); then
            for tray_id in $trays; do
                if ! grep -qE "Classic notification area ready: ${tray_id}$" <<< "$ready"; then
                    problem="Classic notification area $tray_id failed to initialize (see plasmashell journal)"
                    break
                fi
                volume=$(sed -n "s/^Classic volume frontend required: ${tray_id} //p" <<< "$ready")
                case "$volume" in
                    yes)
                        if [[ $(grep -cFx "Classic volume frontend ready: $tray_id" <<< "$ready") != 1 ]]; then
                            problem="Classic volume frontend for notification area $tray_id failed to initialize (see plasmashell journal)"
                        fi ;;
                    no) ;;
                    *) problem="could not determine whether Classic volume is enabled in notification area $tray_id" ;;
                esac
            done
        else problem="could not verify startup of the Classic notification area"; fi
        if [[ -z $problem && $(grep -cFx 'Classic notification frontend ready' <<< "$ready") != 1 ]]; then
            problem="could not verify exactly one Classic notification frontend (see plasmashell journal)"
        fi
    fi
    if [[ -z $problem && $target == windows ]]; then
        systemd-run --user --wait --pipe --collect -q "$probe" >> "$state/switch.log" || problem="effective Win7Classic style/palette check failed (see switch.log)"
        # KWin reports the requested theme even when its QML fails and a substitute is drawn.
        local decoration errors
        if errors=$(journalctl --user -b -u plasma-kwin_wayland --after-cursor "$decoration_cursor" --no-pager -o cat) &&
                ! grep -Fq 'Failed to initialize decoration theme' <<< "$errors"; then :
        else
            log "decoration activation errors: $errors"
            problem="KWin rejected the Classic decoration (see switch.log and journalctl --user -u plasma-kwin_wayland)"
        fi
        if decoration=$(qdbus6 org.kde.KWin /KWin supportInformation | sed -n '/^Decoration$/,/^Output backend$/p') &&
                grep -qx 'Plugin: org.kde.kwin.aurorae' <<< "$decoration" && grep -qx 'Theme: win7classic2' <<< "$decoration"; then
            log "effective decoration: org.kde.kwin.aurorae / win7classic2"
        else
            log "rejected decoration: $decoration"
            problem="KWin rejected the Classic decoration (see switch.log and journalctl --user -u plasma-kwin_wayland)"
        fi
    fi
    if [[ -n $problem ]]; then
        log "rolling back to $from: $problem"
        stop_shell
        if [[ $target == windows ]]; then
            if ! $tried_target || restore_tray_shortcuts; then
                clear_tray_shortcuts
            else
                log "ERROR: could not restore tray accelerators; receipt retained: $accelerators"
            fi
        fi
        copy_files "$state/profiles/$from" "$config" || die "rollback could not copy the $from layout; run: win7-classic restore"
        load_appearance $from "$state/profiles/$from"
        start_shell || die "rollback could not start plasmashell; run: win7-classic restore"
        log "ERROR: switch to $target failed ($problem); still in $from mode"
        return "$failure_status"
    fi
    echo "$target" > "$state/mode"
    [[ $target != current ]] || clear_tray_shortcuts
    log "now in $target mode: $(digest "$config")"
}

restore() {
    warn_legacy_other_root
    migrate_legacy_decoration
    [[ -d $state/profiles/current ]] || { [[ $(mode) == current ]] && { log "already current; nothing saved"; return 0; }; die "no saved current profile"; }
    log "restore: forcing current mode"
    systemctl --user stop plasma-plasmashell.service || true
    pkill -u "$UID" -x plasmashell || true
    # Keep whatever was live, in case it held edits worth recovering.
    rm -rf "$state/profiles/before-restore" && mkdir "$state/profiles/before-restore"
    copy_files "$config" "$state/profiles/before-restore"
    save_keys "$state/profiles/before-restore"
    gtk_theme > "$state/profiles/before-restore/gtk-theme"
    if ! restore_tray_shortcuts; then
        start_shell || die "could not restart plasmashell after accelerator restore failed"
        die "could not restore current tray accelerators"
    fi
    copy_files "$state/profiles/current" "$config"
    load_appearance current "$state/profiles/current"
    echo current > "$state/mode"
    start_shell || die "plasmashell did not start after restore"
    clear_tray_shortcuts
    log "restored current: $(digest "$config")"
}

# Throw away the saved Windows layout and build a fresh one from the current layout.
rebuild() {
    preflight_windows
    [[ $(mode) == current ]] || switch_to current
    rm -rf "$state/profiles/windows"
    log "rebuild: Windows layout discarded; rebuilding from current layout"
    switch_to windows
}

# Two simultaneous switches must not share an in-progress layout or accelerator receipt.
if [[ ${1:-} != status ]]; then
    exec 9>"$state/switch.lock"
    flock -n 9 || die "another mode switch is in progress"
fi

case ${1:-} in
    windows|current) switch_to "$1" ;;
    toggle) if [[ $(mode) == current ]]; then switch_to windows; else switch_to current; fi ;;
    restore) restore ;;
    rebuild) rebuild ;;
    status) mode ;;
    *) echo "usage: win7-classic windows|current|toggle|status|restore|rebuild" >&2; exit 2 ;;
esac
