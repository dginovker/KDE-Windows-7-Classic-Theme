[Desktop Entry]
Type=Application
Name=Windows Explorer
GenericName=File Manager
Comment=Windows 7 Classic file manager
Exec=@CMAKE_INSTALL_FULL_BINDIR@/win7-explorer %U
Icon=org.win7classic.explorer
# Declaring inode/directory would let Explorer win over Dolphin in current mode when the user
# has no explicit default. Windows mode selects it through mimeapps.list instead (toggle/windows/keys).
MimeType=x-scheme-handler/win7-explorer;
Categories=Qt;KDE;System;FileTools;FileManager;
