# Builds from this checkout: `makepkg -si` inside packaging/.
# Tested with Plasma/KWin 6.8.2 and Qt 6.12; the QML relies on Plasma 6.8 APIs.
pkgname=win7-classic
pkgver=0.4
pkgrel=6
pkgdesc='Windows 7 Classic look for KDE Plasma, switchable live with win7-classic'
arch=(x86_64)
url='https://github.com/dginovker/KDE-Windows-7-Classic-Theme'
# Wine's Tahoma (bundled font) is LGPL; everything else is GPL.
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
# plasma-desktop provides kcm_clock (and pulls in systemsettings).
depends=('plasma-desktop>=6.8' 'plasma-workspace>=6.8' 'kwin>=6.8' 'kio>=6.17' 'kwindowsystem' 'python' 'dconf' 'dbus' 'glib2' 'qt6-tools' 'qt6-wayland' 'wayland')
makedepends=('wine' 'python-fonttools' 'cmake' 'extra-cmake-modules' 'plasma-wayland-protocols')
options=(!debug)
install=win7-classic.install

package() {
    "$startdir/../install.sh" --prefix "$pkgdir"
    install -dm755 "$pkgdir/usr/share/fontconfig/conf.default"
    ln -s ../conf.avail/70-win7-classic-tahoma.conf "$pkgdir/usr/share/fontconfig/conf.default/"
    install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
